# ==========================================
# Configuración de Entorno - Portafolio
# ==========================================

# Entorno: True para producción (Docker/VPS), False para desarrollo local
DEPLOY=False

# Clave secreta de Django (en producción usar un valor criptográficamente seguro)
SECRET_KEY=django-insecure-change-this-in-production

# Hosts permitidos separados por coma (ej: tudominio.com,localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos (PostgreSQL en producción; si DB_NAME/DB_USER quedan vacíos, usa SQLite local)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portafolio_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_HOST=localhost
DB_PORT=5432

# Rutas en contenedor / servidor
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
